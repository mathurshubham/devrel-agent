# ── Database (Postgres) ───────────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_strong_password
# External DATABASE_URL for local development (not using Docker)
# For Docker internal networking, this is usually: postgresql+asyncpg://sentinel:change_me_strong_password@db:5432/sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:change_me_strong_password@localhost:5432/sentinel

# ── Redis ──────────────────────────────────────────────────────────────────
# Security: used by Docker 'redis' service and clients
REDIS_PASSWORD=change_me_redis_password
# redis://[:password]@host:port/db
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# ── Encryption (BYOK Vault) ─────────────────────────────────────────────────
# Exactly 64 hex characters (32 bytes).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Observability (Optional) ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Frontend API URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
