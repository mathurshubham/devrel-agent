# ── Database (Postgres) ───────────────────────────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_strong_password
# External DATABASE_URL for local development (not using Docker)
# For Docker internal networking, this is usually: postgresql+asyncpg://sentinel:change_me_strong_password@db:5432/sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:change_me_strong_password@localhost:5432/sentinel

# ── Redis ──────────────────────────────────────────────────────────────────
# Security: used by Docker 'redis' service and clients
REDIS_PASSWORD=change_me_redis_password
# redis://[:password]@host:port/db
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# ── Encryption (BYOK Vault) ─────────────────────────────────────────────────
# Exactly 64 hex characters (32 bytes).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# JWKS endpoint used to verify Clerk session JWTs (see backend/utils/auth.py).
# Typically https://<your-app>.clerk.accounts.dev/.well-known/jwks.json (dev)
# or https://clerk.<your-domain>.com/.well-known/jwks.json (prod, custom domain).
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# Signing secret for the Clerk webhook endpoint (svix). From the Clerk
# dashboard's Webhooks tab, per-endpoint.
CLERK_WEBHOOK_SECRET=whsec_...

# ── LLM (BYOK vault, OpenRouter is the default provider) ────────────────────
# Dev-only fallback used when an org has no LLM key saved in its vault yet
# (backend/agent/nodes/*.py fall back to this rather than failing outright).
OPENROUTER_API_KEY=sk-or-v1-...

# ── Apify (source-platform scraping) ────────────────────────────────────────
# Dev bootstrap token; orgs otherwise bring their own via org_apify_tokens.
APIFY_TOKEN=apify_api_...

# ── Observability (Optional) ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Frontend API URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
